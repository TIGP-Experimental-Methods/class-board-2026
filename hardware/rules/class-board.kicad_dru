(version 1)

# ---- inner layers are pure GND planes: no tracks there (user decision 2026-09-07, D-01)
(rule "no_inner_tracks"
	(layer inner)
	(condition "A.Type == 'Track' || A.Type == 'Arc'")
	(constraint disallow track))

# ---- isolated inputs: 2.5 mm to everything that is not part of the isolated group (brief 4.3 / 7.5)
(rule "iso_in_clearance"
	(condition "A.NetClass == 'ISO_IN' && B.NetClass != 'ISO_IN' && !(A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint(B))")
	(constraint clearance (min 2.5mm)))

# ---- analog inputs: 0.3 mm clearance, outer layers only (brief 4.3)
(rule "analog_in_clearance"
	(condition "A.NetClass == 'ANALOG_IN' && A.Type == 'Track' && B.NetName != 'AGND'")
	(constraint clearance (min 0.3mm)))

# ---- power rails: widths are set by the generator (1.0 / 0.5 mm, necked to 0.25 mm only at fine-pitch pins);
#      no minimum-width rule because a rule cannot exempt the neck-downs (see docs/design-review.md)

# ---- manufacturing margins (JLC 4-layer: 0.09/0.09 mm trace/space, 0.15 mm drill, 0.2 mm hole-to-hole; ours are deliberately wider)
(rule "hole_to_hole"
	(constraint hole_to_hole (min 0.5mm))
	(condition "A.Type == 'Via' || A.Type == 'Pad'"))
(rule "annular_ring"
	(constraint annular_width (min 0.15mm))
	(condition "A.Type == 'Via'"))
(rule "copper_to_edge"
	(constraint edge_clearance (min 0.3mm)))

# ---- the MAINS rules come LAST on purpose: KiCad applies the last rule that matches, so they must
#      stand after the general clearance and edge rules above or those would override them.
# ---- MAINS relay channels (D-51, 2026-09-16): the four relay contact circuits are built so that a 110 V or
#      220 V wall socket wired into a terminal is safe.  Reinforced spacing for a 250 V working voltage
#      (IEC 62368-1, pollution degree 2, FR4 material group IIIb): basic 1.5 mm, reinforced = 2 x = 5.0 mm.
#      Every relay contact net is in the MAINS class and also in its own channel class MAINS1..MAINS4.
#      Pad pairs inside one footprint are excluded: the coil-to-contact distance of the relay itself is the
#      manufacturer's isolation (1.5 kV test), not a spacing the board layout may change.
(rule "mains_to_other"
	(condition "A.NetClass == 'MAINS' && !(B.NetClass == 'MAINS') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint(B))")
	(constraint clearance (min 5.0mm)))

# ---- one channel to another: two channels can sit on different 110 V legs (220 V between them)
(rule "mains_between_channels1"
	(condition "A.NetClass == 'MAINS1' && B.NetClass == 'MAINS' && !(B.NetClass == 'MAINS1')")
	(constraint clearance (min 5.0mm)))
(rule "mains_between_channels2"
	(condition "A.NetClass == 'MAINS2' && B.NetClass == 'MAINS' && !(B.NetClass == 'MAINS2')")
	(constraint clearance (min 5.0mm)))
(rule "mains_between_channels3"
	(condition "A.NetClass == 'MAINS3' && B.NetClass == 'MAINS' && !(B.NetClass == 'MAINS3')")
	(constraint clearance (min 5.0mm)))
(rule "mains_between_channels4"
	(condition "A.NetClass == 'MAINS4' && B.NetClass == 'MAINS' && !(B.NetClass == 'MAINS4')")
	(constraint clearance (min 5.0mm)))

# ---- inside one channel (COM / NO / NC of the same relay and terminal): basic spacing at the switched
#      voltage.  A custom rule wins over the 5.0 mm clearance of the MAINS net class, and no other rule here
#      matches a pair of nets of the same channel, so 2.0 mm is what the DRC asks for inside a channel.
(rule "mains_within_channel1"
	(condition "A.NetClass == 'MAINS1' && B.NetClass == 'MAINS1' && !(A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint(B))")
	(constraint clearance (min 2.0mm)))
(rule "mains_within_channel2"
	(condition "A.NetClass == 'MAINS2' && B.NetClass == 'MAINS2' && !(A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint(B))")
	(constraint clearance (min 2.0mm)))
(rule "mains_within_channel3"
	(condition "A.NetClass == 'MAINS3' && B.NetClass == 'MAINS3' && !(A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint(B))")
	(constraint clearance (min 2.0mm)))
(rule "mains_within_channel4"
	(condition "A.NetClass == 'MAINS4' && B.NetClass == 'MAINS4' && !(A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint(B))")
	(constraint clearance (min 2.0mm)))

# ---- a metal lid or a hand at the board edge
(rule "mains_edge"
	(condition "A.NetClass == 'MAINS'")
	(constraint edge_clearance (min 2.0mm)))

# ---- mains stays on the top layer and never goes through the board: no inner or bottom copper, no vias
(rule "mains_layers_inner"
	(layer inner)
	(condition "A.NetClass == 'MAINS'")
	(constraint disallow track zone))
(rule "mains_layers_back"
	(layer "B.Cu")
	(condition "A.NetClass == 'MAINS'")
	(constraint disallow track zone))
(rule "mains_no_via"
	(condition "A.NetClass == 'MAINS'")
	(constraint disallow via))

# ---- 3 mm of 1 oz outer copper carries the 5 A the channel is rated for with a small temperature rise
(rule "mains_width"
	(condition "A.NetClass == 'MAINS'")
	(constraint track_width (min 3.0mm)))

# ---- section ownership (v0.7, 2026-09-13): Block field -> owner area. A = B1/OPT/NMR_RX, B = B3/B5/NMR_TX, C = B2/B4/C_SW
(rule "owner_A" (condition "A.Type == 'Footprint' && (A.getField('Block') == 'B1' || A.getField('Block') == 'OPT' || A.getField('Block') == 'NMR_RX' || A.getField('Block') == 'A')") (constraint assertion "A.enclosedByArea('ZONE_A')"))
(rule "owner_B" (condition "A.Type == 'Footprint' && (A.getField('Block') == 'B3' || A.getField('Block') == 'B5' || A.getField('Block') == 'NMR_TX' || A.getField('Block') == 'B')") (constraint assertion "A.enclosedByArea('ZONE_B')"))
(rule "owner_C" (condition "A.Type == 'Footprint' && (A.getField('Block') == 'B2' || A.getField('Block') == 'B4' || A.getField('Block') == 'C_SW' || A.getField('Block') == 'C')") (constraint assertion "A.enclosedByArea('ZONE_C')"))
