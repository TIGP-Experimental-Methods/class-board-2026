(version 1)

# ---- inner layers are pure GND planes: no tracks there (user decision 2026-09-07, D-01)
(rule "no_inner_tracks"
	(layer inner)
	(condition "A.Type == 'Track' || A.Type == 'Arc'")
	(constraint disallow track))

# ---- isolated inputs: 2.5 mm to everything that is not part of the isolated group (brief 4.3 / 7.5)
(rule "iso_in_clearance"
	(condition "A.NetClass == 'ISO_IN' && B.NetClass != 'ISO_IN' && !(A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint(B))")
	(constraint clearance (min 2.5mm)))

# ---- analog inputs: 0.3 mm clearance, outer layers only (brief 4.3)
(rule "analog_in_clearance"
	(condition "A.NetClass == 'ANALOG_IN' && A.Type == 'Track' && B.NetName != 'AGND'")
	(constraint clearance (min 0.3mm)))

# ---- power rails: widths are set by the generator (1.0 / 0.5 mm, necked to 0.25 mm only at fine-pitch pins);
#      no minimum-width rule because a rule cannot exempt the neck-downs (see docs/design-review.md)

# ---- manufacturing margins (JLC 4-layer: 0.09/0.09 mm trace/space, 0.15 mm drill, 0.2 mm hole-to-hole; ours are deliberately wider)
(rule "hole_to_hole"
	(constraint hole_to_hole (min 0.5mm))
	(condition "A.Type == 'Via' || A.Type == 'Pad'"))
(rule "annular_ring"
	(constraint annular_width (min 0.15mm))
	(condition "A.Type == 'Via'"))
(rule "copper_to_edge"
	(constraint edge_clearance (min 0.3mm)))

# ---- section ownership (v0.7d, 2026-09-17): Block field -> owner area.
#      A = B1/OPT/NMR_RX, B = B3/B5/NMR_TX.  Section C is the front-panel board now (its own
#      project), so what was ZONE_C on the main board is the instructor's area ZONE_INSTR:
#      the power entry (B2) and the coil switches (C_SW).  The B4 block (relays and isolated
#      inputs) was deleted in v0.7d, together with the MAINS net classes and their rules.
(rule "owner_A" (condition "A.Type == 'Footprint' && (A.getField('Block') == 'B1' || A.getField('Block') == 'OPT' || A.getField('Block') == 'NMR_RX' || A.getField('Block') == 'A')") (constraint assertion "A.enclosedByArea('ZONE_A')"))
(rule "owner_B" (condition "A.Type == 'Footprint' && (A.getField('Block') == 'B3' || A.getField('Block') == 'B5' || A.getField('Block') == 'NMR_TX' || A.getField('Block') == 'B')") (constraint assertion "A.enclosedByArea('ZONE_B')"))
(rule "owner_INSTR" (condition "A.Type == 'Footprint' && (A.getField('Block') == 'B2' || A.getField('Block') == 'C_SW' || A.getField('Block') == 'C')") (constraint assertion "A.enclosedByArea('ZONE_INSTR')"))
