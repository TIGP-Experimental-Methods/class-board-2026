		(uuid "44c6fdfb-d4e3-5559-9fc9-92520ff1486d")
	)
	(text "FB802 (120 R @ 100 MHz, 3 A) isolates the OPA564 V+ branch from the +VEXT input; C815 47 uF + C816 100 nF sit after it, at the V+ pins (SBOS372E Fig. 35)."
		(exclude_from_sim no)
		(at 330.2 119.38 0)
