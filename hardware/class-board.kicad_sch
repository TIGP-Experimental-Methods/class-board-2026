  (title_block (title "TIGP class board 2026 — root") (date "2026-09-07") (rev "A") (company "TIGP class board 2026") (comment 1 "ESP32-S3 laboratory instrument carrier + NMR console: base + 3 student sections (A inputs/receiver, B outputs/timing/tra"))
  (lib_symbols
  )
  (text "TIGP CLASS BOARD 2026 — laboratory instrument carrier (ESP32-S3 dev board) with NMR console, rev B (v0.7, 2026-09-13)" (exclude_from_sim no) (at 12.7 16 0) (effects (font (size 3.5 3.5) (bold yes)) (justify left bottom)) (uuid "202e0ac0-20db-50a1-8572-f434e85c4e08"))
  (text "Design brief v0.6 + notes/2026-09-13-nmr-respec-proposal.md (v0.7) + hardware/docs/design-decisions.md. Interface nets between sheets are global labels; rails are power symbols; AGND meets GND only at NT1." (exclude_from_sim no) (at 12.7 21 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "b8d6b26d-563e-57f7-9c1f-79f12119e18b"))
  (text "Stack-up: L1 signal/power, L2 GND, L3 GND, L4 signal/power. Board 180 x 100 mm, 4 x M3. Bottom side: three 2x20 straight male headers (J6 at x 12, J7 at x 90, J8 at x 168 mm) carry the front panel (180 x 100, 17 SMA) flat on the back of the board. Rear edge: USB-C, 5 V jack, external power, H-bridge and polarizer coil terminals. Sections: A = B1 + NMR RX, B = B3 + B5 + NMR TX, C = the front-panel board; the power entry and the coil switches are the instructor’s (ZONE_INSTR). v0.7d: the four relays and the two isolated inputs left the main board — it offers 5 V TTL module outputs instead and switches no mains." (exclude_from_sim no) (at 12.7 25 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "cb155841-d54d-53ee-9a61-ccd13c3cf872"))
  (text "BASE: dev-board socket, buses, expansion, star point" (exclude_from_sim no) (at 14.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "66bc59d0-c3ee-545f-bfe9-32cd58dc7891"))
  (text "B2 (C): power entry, +-12 V, LDOs" (exclude_from_sim no) (at 114.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "a2fa922d-d18d-5199-ada9-f939512d25d6"))
  (text "B1 (A): 8 x +-10 V inputs, ADS8688" (exclude_from_sim no) (at 214.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "455ab1e8-4dcb-5b2a-963d-670c3ba0e400"))
  (text "B3 (B): DAC8563 + OPA2192 -> AO1/AO2" (exclude_from_sim no) (at 314.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "71b84f52-3b56-559c-b23e-039b6e7f1af5"))
  (text "B5 (B): TCA9535 -> 8 TTL DIO + 8 module outputs, 2 fast outs, TRIG" (exclude_from_sim no) (at 14.2 107 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "b63b6abd-3cc0-5b85-b053-516e2848f2e8"))
  (text "LINK: 3 x 2x20 to the front panel (bottom side)" (exclude_from_sim no) (at 114.2 107 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "19e14ffd-4be1-54de-b131-90aac7ca170e"))
  (text "C: external power input, DRV8871 field-cycling H-bridge, polarizer MOSFET switch" (exclude_from_sim no) (at 214.2 107 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "cd19d0f0-e3ee-5f37-b837-737fdde0e3e9"))
  (text "NMR RX (A): tank, LNA, blanking, I/Q mixer, IF -> ADC ch 7/8" (exclude_from_sim no) (at 314.2 107 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "262437e5-06bb-52d6-a842-11afb66c0b3f"))
  (text "NMR TX (B): AD9834 DDS, reconstruction filter, OPA564 power stage -> TX" (exclude_from_sim no) (at 14.2 152 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "c19ebde6-621c-52da-a9ba-785604731e04"))
  (text "GPIO map v0.7 (interface contract, brief 4.2 + proposal 8.2)" (exclude_from_sim no) (at 12.7 177 0) (effects (font (size 1.5 1.5) (bold yes)) (justify left bottom)) (uuid "ddb68c54-0886-5241-8bd5-714db01424a3"))
  (text "Rails (brief 4.1, updated per design-decisions D-02/D-04; +VEXT 7-18 V external input on the C sheet)" (exclude_from_sim no) (at 200 177 0) (effects (font (size 1.5 1.5) (bold yes)) (justify left bottom)) (uuid "9c3ba887-9d3a-5b5a-a17b-aaff0c0f80a5"))
  (text "Reference ranges: base 1-99, B1 100-199, B2 200-299, B3 300-399, B5 500-599, NMR RX 700-799, NMR TX 800-899, coil switches / external power 900-999. B4 (400-499, relays and isolated inputs) was deleted in v0.7d; the owner-zone DRC uses the Block field." (exclude_from_sim no) (at 12.7 272 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "f0bcb2a0-2b3c-5a9b-bf54-90cd1a5cc7f0"))
