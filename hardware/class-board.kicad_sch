  (title_block (title "TIGP class board 2026 — root") (date "2026-09-07") (rev "A") (company "TIGP class board 2026") (comment 1 "ESP32-S3 laboratory instrument carrier + NMR console: base + 3 student sections (A inputs/receiver, B outputs/timing/tra"))
  (lib_symbols
  )
  (text "TIGP CLASS BOARD 2026 — laboratory instrument carrier (ESP32-S3 dev board) with NMR console, rev B (v0.7, 2026-09-13)" (exclude_from_sim no) (at 12.7 16 0) (effects (font (size 3.5 3.5) (bold yes)) (justify left bottom)) (uuid "64130283-34ab-5c3c-b8b7-711c5a84748f"))
  (text "Design brief v0.6 + notes/2026-09-13-nmr-respec-proposal.md (v0.7) + hardware/docs/design-decisions.md. Interface nets between sheets are global labels; rails are power symbols; AGND meets GND only at NT1." (exclude_from_sim no) (at 12.7 21 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "c616cd90-d9cd-53f7-b6fe-46fc99f0f767"))
  (text "Stack-up: L1 signal/power, L2 GND, L3 GND, L4 signal/power. Board 180 x 100 mm, 4 x M3. Bottom side: three 2x20 straight male headers (J6 at x 12, J7 at x 90, J8 at x 168 mm) carry the front panel (180 x 100, 17 SMA) flat on the back of the board. Rear edge: USB-C, 5 V jack, external power, H-bridge and polarizer coil terminals. Sections: A = B1 + NMR RX, B = B3 + B5 + NMR TX, C = the front-panel board; the power entry and the coil switches are the instructor’s (ZONE_INSTR). v0.7d: the four relays and the two isolated inputs left the main board — it offers 5 V TTL module outputs instead and switches no mains." (exclude_from_sim no) (at 12.7 25 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "e424c74f-df72-5a5e-8d4d-6eee8a966876"))
  (text "BASE: dev-board socket, buses, expansion, star point" (exclude_from_sim no) (at 14.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "78229dc1-6dab-5e40-9609-5638230e5701"))
  (text "B2 (C): power entry, +-12 V, LDOs" (exclude_from_sim no) (at 114.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "f83eb49b-59dc-5efc-833d-339b7c32711f"))
  (text "B1 (A): 8 x +-10 V inputs, ADS8688" (exclude_from_sim no) (at 214.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "95da90f7-0082-5f1a-ad28-c37e250d44d3"))
  (text "B3 (B): DAC8563 + OPA2192 -> AO1/AO2" (exclude_from_sim no) (at 314.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "1a6b943e-c368-5447-9733-7c2eb5367155"))
  (text "B5 (B): TCA9535 -> 8 TTL DIO + 8 module outputs, 2 fast outs, TRIG" (exclude_from_sim no) (at 14.2 107 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "7146f0d9-28b7-5ded-8014-ea782cf178f0"))
  (text "LINK: 3 x 2x20 to the front panel (bottom side)" (exclude_from_sim no) (at 114.2 107 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "a34d0ae7-d02a-54ef-bfeb-aaadbc0d9ba7"))
  (text "C: external power input, DRV8871 field-cycling H-bridge, polarizer MOSFET switch" (exclude_from_sim no) (at 214.2 107 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "aa4f37b8-ebdb-5404-a6f1-e636220f1247"))
  (text "NMR RX (A): tank, LNA, blanking, I/Q mixer, IF -> ADC ch 7/8" (exclude_from_sim no) (at 314.2 107 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "afb69cd7-11e3-5aa7-9f83-c7dd9338e68c"))
  (text "NMR TX (B): AD9834 DDS, reconstruction filter, OPA564 power stage -> TX" (exclude_from_sim no) (at 14.2 152 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "e8cf6b05-9574-591d-8ea6-7c366e2f9ffa"))
  (text "GPIO map v0.7 (interface contract, brief 4.2 + proposal 8.2)" (exclude_from_sim no) (at 12.7 177 0) (effects (font (size 1.5 1.5) (bold yes)) (justify left bottom)) (uuid "64d9b2aa-bd06-561a-bd9e-20f9e9e88928"))
  (text "Rails (brief 4.1, updated per design-decisions D-02/D-04; +VEXT 7-18 V external input on the C sheet)" (exclude_from_sim no) (at 200 177 0) (effects (font (size 1.5 1.5) (bold yes)) (justify left bottom)) (uuid "b6732a37-bcd9-5f80-a1da-153dbd376d34"))
  (text "Reference ranges: base 1-99, B1 100-199, B2 200-299, B3 300-399, B5 500-599, NMR RX 700-799, NMR TX 800-899, coil switches / external power 900-999. B4 (400-499, relays and isolated inputs) was deleted in v0.7d; the owner-zone DRC uses the Block field." (exclude_from_sim no) (at 12.7 272 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "43758878-e37a-54f0-8446-3cc15b555c61"))
  (text "Student gapped copies (D6) are derived from these sheets: see hardware/student/ and docs/student-deletions.md." (exclude_from_sim no) (at 12.7 276 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "b876e29c-d746-567e-8741-a41f917dc987"))
