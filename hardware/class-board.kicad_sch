  (text "TIGP CLASS BOARD 2026 — laboratory instrument carrier (ESP32-S3 dev board) with NMR console, rev B (v0.7, 2026-09-13)" (exclude_from_sim no) (at 12.7 16 0) (effects (font (size 3.5 3.5) (bold yes)) (justify left bottom)) (uuid "c375eb90-bbe5-55b9-8935-5e4cf1b25309"))
  (text "Design brief v0.6 + notes/2026-09-13-nmr-respec-proposal.md (v0.7) + hardware/docs/design-decisions.md. Interface nets between sheets are global labels; rails are power symbols; AGND meets GND only at NT1." (exclude_from_sim no) (at 12.7 21 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "ff58946f-632c-5e17-bc74-5730b9e47c0b"))
  (text "Stack-up: L1 signal/power, L2 GND, L3 GND, L4 signal/power. Board 160 x 100 mm, 4 x M3. Front edge: 2x20 link to the SMA/OLED/LED panel (160 x 65, 3 x 5 SMA). Rear edge: USB-C, 5 V jack, terminals, external power. Sections: A = B1 + NMR RX, B = B3 + B5 + NMR TX, C = B2 + B4 + coil switches." (exclude_from_sim no) (at 12.7 25 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "2a354b45-0f41-5f82-82d8-33235e00be66"))
  (text "BASE: dev-board socket, buses, expansion, star point" (exclude_from_sim no) (at 14.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "a8d8ff0b-70cb-5e78-9bea-8556eeb8b76c"))
  (text "B2 (C): power entry, +-12 V, LDOs" (exclude_from_sim no) (at 114.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "f5db3867-ddfe-5228-9bde-5396f0e82a06"))
  (text "B1 (A): 8 x +-10 V inputs, ADS8688" (exclude_from_sim no) (at 214.2 62 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "c5fcba5a-072a-5f72-958b-d9e1a4ccf9c1"))
