  (text "panel label: AI4   (97, 43) mm" (exclude_from_sim no) (at 307 278 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "9e6bebac-129c-5a6a-9981-63081fa946b4"))
