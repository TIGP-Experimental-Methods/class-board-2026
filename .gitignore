# PlatformIO
firmware/.pio/
firmware/.vscode/
# generated: copied from host/pwa by scripts/copy_pwa.py
firmware/data/
firmware/include/secrets.h

# Python
__pycache__/
*.pyc
*.egg-info/
host/build/
host/dist/
.venv/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# KiCad backups (hardware/ is managed separately)
hardware/**/*-backups/
hardware/**/*.kicad_prl
hardware/**/fp-info-cache

# hardware/lib generation scratch
hardware/lib/*.log
hardware/lib/*_done.txt
hardware/lib/e2k_slow*
hardware/lib/class_board/
hardware/lib/symbol/

# uv lock from local `uv pip install -e host/` (not used by SETUP.md or CI)
host/uv.lock

# KiCad: STEP models stay on the shared drive (125 MB); footprints reference the .wrl files
hardware/lib/class_board.3dshapes/*.step
hardware/.netlist.xml
hardware/scripts/__pycache__/

# Claude Code MCP configuration (machine-specific path to the Konnect binary; SETUP.md Step 10)
.mcp.json

# main_sections.py / panel_sections.py outputs (the instructor accepts a merge by hand)
hardware/class-board-merged.*
hardware/front-panel/front-panel-merged.*
hardware/scratchpad/
