; Copy this file to secrets.ini (git-ignored) for uploads over WiFi:
;   pio run -e esp32s3-ota -t upload     (firmware)
;   pio run -e esp32s3-ota -t uploadfs   (web app)
; host     = the board's name, as the serial log prints it (instrument-XXXX.local)
; password = the OTA_PASSWORD from include/secrets.h
[ota]
host = instrument-XXXX.local
password = choose-a-password
